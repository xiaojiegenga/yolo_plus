# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Model weights and exported checkpoints
*.pt
*.pth

# Raw training and validation outputs
/runs/
/runs_seg/

# User-managed local experiment archive
# Baseline/V1 and future successful raw runs are copied here manually.
# This directory must remain local and must not be uploaded to Git.
/results/

# Frequently updated project notes and AI context
# Keep these files local so branch switching and rollback do not change them.
# Only formal experiment records under /experiment_records/ remain tracked.
/*.md
/experiments/*.md
/scripts/*.md

# Local safety copies created during project maintenance
/.local_backups/

# Local assistant/editor state
/.claude/
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Dataset config containing machine-specific paths
yolo_data.yaml
/experiments/*.local.yaml

# Conda environment metadata
conda-meta/

# Logs
*.log
